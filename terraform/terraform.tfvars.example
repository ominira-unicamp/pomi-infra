aws_region       = "sa-east-1"
environment      = "production"
# A instância mantém o identificador físico legado para evitar substituição;
# semanticamente este ambiente é o dev atual.

lightsail_availability_zone = "sa-east-1a"
lightsail_blueprint_id      = "ubuntu_24_04"
lightsail_bundle_id         = "micro_3_1"
lightsail_snapshot_time     = "06:00"
lightsail_ssh_public_key    = "ssh-ed25519 AAAA... pomi-deploy"

pomi_smtp_password_parameter_name    = "/pomi/smtp-password"
pomi_openobserve_auth_parameter_name = "/pomi/openobserve-auth"

pomi_smtp_host = "smtp.example.org"
pomi_smtp_port = 587
pomi_smtp_user = "pomi@example.org"
pomi_smtp_from = "POMI <pomi@example.org>"

pomi_openobserve_url = "https://api.openobserve.ai/api/minha-organizacao"

vercel_team_id          = "team_xxxxxxxxx"
pomi_environment                      = "test"
pomi_frontend_project_name            = "pomi-frontend"
pomi_frontend_git_repository          = "ominira-unicamp/pomi-frontend"
# pomi_frontend_root_directory        = null
# pomi_frontend_url                   = "https://pomi-frontend.example.org"
# pomi_data_api_domain_name            = "data.pomi.example.org"
# pomi_app_api_domain_name             = "app.pomi.example.org"
# pomi_keycloak_domain_name            = "auth.example.org"
pomi_keycloak_realm                   = "pomi"
pomi_keycloak_client_id               = "pomi-frontend"
pomi_keycloak_admin_password_parameter_name = "/pomi/planner/test/keycloak-admin-password"
pomi_postgres_password_parameter_name = "/pomi/planner/test/postgres-password"
pomi_data_admin_token_parameter_name = "/pomi/planner/test/data-admin-token"
pomi_notifier_unsubscribe_secret_parameter_name = "/pomi/planner/test/notifier-unsubscribe-secret"
pomi_backup_retention_days           = 30
# pomi_backup_bucket_name = "meu-bucket-globalmente-unico"

registry_image_retention = 20
